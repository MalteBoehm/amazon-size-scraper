FROM golang:1.25

# ------------------------------------------------------------
# Base system + build tooling
# (Initial minimal set; extended runtime deps added further below)
# ------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    tzdata \
    git \
    wget \
    unzip \
    curl \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy event-contracts module first (for go.mod replace directive)
COPY event-contracts /event-contracts

# Using external tall-affiliate-common repository - no local copy needed

# Copy go mod files from amzon-size-scraper
COPY amzon-size-scraper/go.mod amzon-size-scraper/go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY amzon-size-scraper/ .

# Build the application (static binary)
RUN CGO_ENABLED=0 GOOS=linux go build -o amazon-scraper ./cmd/amazon-scraper

# ------------------------------------------------------------
# Playwright runtime system dependencies
# Error observed: "Host system is missing dependencies to run browsers"
# We install the set suggested by Playwright plus common missing libs for Debian (golang:1.25 base).
# Keeping in ONE layer to minimize image size.
# ------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Core Playwright browser deps (mirrors the list from error output)
    libglib2.0-0 \
    libnss3 \
    libnspr4 \
    libdbus-1-3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libatspi2.0-0 \
    libx11-6 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libxcb1 \
    libxkbcommon0 \
    libasound2 \
    # Helpful extras sometimes required
    libcups2 \
    libdrm2 \
    libexpat1 \
    libxshmfence1 \
    # Fonts (subset – broad language coverage)
    fonts-unifont \
    fonts-liberation \
    fonts-ipafont-gothic \
    fonts-wqy-zenhei \
    fonts-thai-tlwg \
    fonts-freefont-ttf \
    # Clean
    && rm -rf /var/lib/apt/lists/*

# Install playwright (chromium) AFTER deps; pin version of helper CLI
RUN go run github.com/playwright-community/playwright-go/cmd/playwright@v0.5200.0 install chromium

# Expose port
EXPOSE 8084

# Make entrypoint script executable (already copied with source code)
RUN chmod +x /app/entrypoint.sh

# Run the application
CMD ["/app/entrypoint.sh"]