FROM mcr.microsoft.com/playwright:v1.52.0-noble

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC \
    GOROOT=/usr/local/go \
    GOPATH=/go \
    PATH=/usr/local/go/bin:/go/bin:$PATH \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates tzdata git wget curl \
    && rm -rf /var/lib/apt/lists/* \
    && ln -fs /usr/share/zoneinfo/$TZ /etc/localtime \
    && dpkg-reconfigure -f noninteractive tzdata \
    && mkdir -p logs/html proxy_data

# Install Go toolchain (single-stage to minimize Coolify ARG injection)
ENV GO_VERSION=1.25.1
RUN curl -fsSL https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz -o /tmp/go.tgz \
    && tar -C /usr/local -xzf /tmp/go.tgz \
    && rm -f /tmp/go.tgz

# Cache deps first
COPY go.mod go.sum ./
RUN go mod download

# Copy source and build
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/size-scraper ./cmd/size-scraper

# Install Playwright-Go driver and ensure Chromium is available
RUN go run github.com/playwright-community/playwright-go/cmd/playwright@v0.5200.0 install chromium || true

EXPOSE 8084
CMD ["/app/size-scraper"]