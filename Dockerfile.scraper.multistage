FROM mcr.microsoft.com/playwright:v1.52.0-noble

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC \
    GOROOT=/usr/local/go \
    GOPATH=/go \
    PATH=/usr/local/go/bin:/go/bin:$PATH \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Install Node.js for npm playwright install
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates tzdata git wget curl \
    && rm -rf /var/lib/apt/lists/* \
    && ln -fs /usr/share/zoneinfo/$TZ /etc/localtime \
    && dpkg-reconfigure -f noninteractive tzdata \
    && mkdir -p logs/html proxy_data

# Install Go toolchain (single-stage to minimize Coolify ARG injection)
ENV GO_VERSION=1.25.1
RUN curl -fsSL https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz -o /tmp/go.tgz \
    && tar -C /usr/local -xzf /tmp/go.tgz \
    && rm -f /tmp/go.tgz

# Cache deps first
COPY go.mod go.sum ./
RUN go mod download

# Copy source and build
COPY . .
# Build the binary specified by BINARY arg (default: size-scraper)
ARG BINARY=size-scraper
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/${BINARY} ./cmd/${BINARY}

# Install Playwright-Go driver and ensure Chromium is available
RUN echo "Installing Playwright browsers..." && \
    go run github.com/playwright-community/playwright-go/cmd/playwright@v0.5200.0 install chromium && \
    echo "Playwright installation completed" && \
    ls -la /ms-playwright/ || echo "Playwright browsers path not found"

# Add debugging for browser installation
RUN echo "Checking for Chromium executables..." && \
    find /ms-playwright -name "chrome" -type f 2>/dev/null || echo "No chrome binary found" && \
    find /ms-playwright -name "headless_shell" -type f 2>/dev/null || echo "No headless_shell found"

# Install Playwright browsers manually as fallback
RUN echo "Manual Playwright browser installation..." && \
    mkdir -p /ms-playwright && \
    npx playwright install chromium --with-deps || echo "npm playwright install failed"

# Set proper permissions for Playwright browsers
RUN chmod -R 755 /ms-playwright || echo "Permission setting failed"

EXPOSE 8084
# Use the binary specified by BINARY arg
ARG BINARY=size-scraper
CMD ["/app/${BINARY}"]