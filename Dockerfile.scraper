# Multi-stage build for Amazon scraper
FROM golang:1.25.0-trixie AS builder

# Allow services to opt-in to Playwright driver install during build
ARG INSTALL_PLAYWRIGHT=true

WORKDIR /app

# Copy go.mod and go.sum first for better caching, then download deps in a single layer
COPY go.mod go.sum ./
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && go mod download

# Copy source code
COPY . .

# Build all binaries and install Playwright in a single layer to minimize RUN invocations
# Use the historical main path for size-scraper to match previous deployments
RUN set -eux; \
    CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o size-scraper ./cmd/size-scraper; \
    CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o lifecycle-consumer ./cmd/lifecycle-consumer; \
    CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o redis-job-consumer ./cmd/redis-job-consumer; \
    CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o job-scraper ./cmd/job-scraper; \
    mkdir -p /root/.cache/ms-playwright-go/1.52.0; \
    if [ "$INSTALL_PLAYWRIGHT" = "true" ]; then \
      go run github.com/playwright-community/playwright-go/cmd/playwright@v0.5200.0 install chromium || true; \
    fi

# Use official Playwright Ubuntu (glibc) runtime image to avoid Alpine/musl issues
FROM mcr.microsoft.com/playwright:v1.52.0-jammy

WORKDIR /app

# Ensure we have privileges to install packages and manage caches
USER root

# Avoid interactive prompts during apt installs
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Copy all binaries from the builder stage
COPY --from=builder /app/size-scraper .
COPY --from=builder /app/lifecycle-consumer .
COPY --from=builder /app/redis-job-consumer .
COPY --from=builder /app/job-scraper .

# Copy Playwright driver (ms-playwright-go) required at runtime for playwright-go
COPY --from=builder /root/.cache/ms-playwright-go /root/.cache/ms-playwright-go

# Copy entrypoint script early so we can set perms in the combined RUN below
COPY entrypoint.sh .

# Install runtime deps, prepare filesystem, set permissions and legacy symlink in a single layer
# netcat-openbsd provides reliable `nc -z` for health waits in entrypoint
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata netcat-openbsd wget \
    && ln -fs /usr/share/zoneinfo/$TZ /etc/localtime \
    && dpkg-reconfigure -f noninteractive tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p logs/html proxy_data \
    && chmod +x entrypoint.sh \
    && ln -sf /app/size-scraper /app/amazon-scraper \
    && mkdir -p /root/.cache \
    && ln -snf /ms-playwright /root/.cache/ms-playwright

## Note: Do not bake proxy_list into /app/proxy_data/proxy_list to avoid dir↔file mount conflicts with Coolify

# Expose port
EXPOSE 8084

# Set entrypoint
ENTRYPOINT ["./entrypoint.sh"]

# Ensure playwright-go uses Node from the image, the preinstalled browsers, and driver cache
ENV PLAYWRIGHT_NODEJS_PATH=/usr/bin/node
ENV PLAYWRIGHT_DRIVER_PATH=/root/.cache/ms-playwright-go/1.52.0
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright