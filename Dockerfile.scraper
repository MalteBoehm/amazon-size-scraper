# Multi-stage build for Amazon scraper
FROM golang:1.25.0-trixie AS builder

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*

# Copy go.mod and go.sum
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the scraper binary
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o scraper ./cmd/scraper

# Use a minimal alpine image
FROM alpine:3.18

WORKDIR /app

# Install dependencies
RUN apk add --no-cache ca-certificates tzdata chromium nss freetype freetype-dev harfbuzz ttf-freefont

# Create necessary directories
RUN mkdir -p logs/html proxy_data

# Copy the binary from the builder stage
COPY --from=builder /app/scraper .

# Copy entrypoint script
COPY entrypoint.sh .

# Make entrypoint executable
RUN chmod +x entrypoint.sh

# Expose port
EXPOSE 8084

# Set entrypoint
ENTRYPOINT ["./entrypoint.sh"]