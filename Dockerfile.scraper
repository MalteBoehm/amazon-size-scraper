FROM golang:1.25-alpine AS builder
WORKDIR /src
ENV CGO_ENABLED=0 GOOS=linux
RUN apk add --no-cache git ca-certificates tzdata

COPY go.mod go.sum ./
RUN go mod download
COPY . .

# Build-time argument to select which binary to build
ARG BINARY
RUN test -n "$BINARY" || (echo "BINARY build-arg is required (e.g., lifecycle-consumer)" && exit 1)
RUN go build -o /out/$BINARY ./cmd/$BINARY

FROM alpine:3.19
WORKDIR /app
RUN apk add --no-cache ca-certificates tzdata postgresql-client
COPY --from=builder /out/* /app/
COPY --from=builder /src/migrations /app/migrations
COPY --from=builder /src/scripts /app/scripts

# Use the binary name as the default command
CMD ["sh", "-c", "exec /app/$(basename ${BINARY:-lifecycle-consumer})"]