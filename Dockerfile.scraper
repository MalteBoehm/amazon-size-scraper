FROM golang:1.25

# ============================================================
# Base system + build tooling
# ============================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    tzdata \
    git \
    wget \
    unzip \
    curl \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build both binaries
RUN CGO_ENABLED=0 GOOS=linux go build -mod=mod -o size-scraper ./cmd/size-scraper
RUN CGO_ENABLED=0 GOOS=linux go build -mod=mod -o lifecycle-consumer-binary ./cmd/lifecycle-consumer

# Create a symlink for backward compatibility
RUN ln -s size-scraper amazon-scraper

# ============================================================
# Playwright runtime system dependencies
# ============================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Core Playwright browser deps
    libglib2.0-0 \
    libnss3 \
    libnspr4 \
    libdbus-1-3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libatspi2.0-0 \
    libx11-6 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libxcb1 \
    libxkbcommon0 \
    libasound2 \
    # Additional dependencies
    libcups2 \
    libdrm2 \
    libexpat1 \
    libxshmfence1 \
    # Fonts
    fonts-unifont \
    fonts-liberation \
    fonts-ipafont-gothic \
    fonts-wqy-zenhei \
    fonts-thai-tlwg \
    fonts-freefont-ttf \
    # Clean
    && rm -rf /var/lib/apt/lists/*

# Install playwright (chromium)
RUN go run github.com/playwright-community/playwright-go/cmd/playwright@v0.5200.0 install chromium

# Create logs directory and proxy data directory
RUN mkdir -p logs/html proxy_data

# Expose port
EXPOSE 8084

# Make entrypoint script executable
RUN chmod +x /app/entrypoint.sh

# Create lifecycle consumer entrypoint
RUN echo '#!/bin/sh\nexec ./lifecycle-consumer-binary "$@"' > /app/lifecycle-consumer && \
    chmod +x /app/lifecycle-consumer

# Create redis job consumer entrypoint
RUN echo '#!/bin/sh\nexec ./redis-job-consumer-binary "$@"' > /app/redis-job-consumer && \
    chmod +x /app/redis-job-consumer

# Run the application
CMD ["/app/entrypoint.sh"]