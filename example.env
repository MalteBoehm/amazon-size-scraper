# ==============================================================================
# Amazon Size Scraper Environment Configuration
# ==============================================================================
# Copy this file to .env and customize the values for your environment.
# This file contains all configuration options for the Docker Compose setup.

# ==============================================================================
# Database Configuration
# ==============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=amazon_scraper

# ==============================================================================
# Redis Configuration
# ==============================================================================
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_PORT=6379

# ==============================================================================
# Browser Configuration
# ==============================================================================
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30s
BROWSER_VIEWPORT_WIDTH=1920
BROWSER_VIEWPORT_HEIGHT=1080
BROWSER_ACCEPT_LANGUAGE=de-DE,de;q=0.9,en;q=0.8
BROWSER_TIMEZONE=Europe/Berlin
BROWSER_LOCALE=de-DE

# ==============================================================================
# Scraper Configuration
# ==============================================================================
# Rate limiting (important to avoid being blocked)
SCRAPER_RATE_LIMIT_MIN=5s
SCRAPER_RATE_LIMIT_MAX=30s
SCRAPER_CONCURRENT_LIMIT=2
SCRAPER_MAX_RETRIES=3
SCRAPER_RETRY_DELAY=5s

# Proxy configuration (set USE_PROXIES=true if you have proxy_list file)
USE_PROXIES=false
PROXY_LIST_FILE=proxy_list

# ==============================================================================
# Logging Configuration
# ==============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
DEBUG_MODE=false
SCRAPER_LOG_HTML=false
SCRAPER_HTML_LOG_DIR=logs/html

# ==============================================================================
# Server Configuration
# ==============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8084

# ==============================================================================
# Event Stream Configuration (for lifecycle consumer)
# ==============================================================================
REDIS_STREAM=product:events:stream

# ==============================================================================
# Example Usage
# ==============================================================================
# Example search URL (t-shirts with size tables)
# SEARCH_URL="https://www.amazon.de/s?k=t-shirt+größentabelle+länge&i=fashion"

# Example single product URL (for debug mode)
# DEBUG_URL="https://www.amazon.de/dp/B08N5WRWNW"

# ==============================================================================
# Development vs Production
# ==============================================================================
# For development:
# - Set DEBUG_MODE=true
# - Set BROWSER_HEADLESS=false to see browser actions
# - Set LOG_LEVEL=debug for detailed logging

# For production:
# - Set DEBUG_MODE=false
# - Set BROWSER_HEADLESS=true
# - Set LOG_LEVEL=info or warn
# - Set USE_PROXIES=true if you have proxies